# ── dbt ───────────────────────────────────────────────────────────────────────
dbt/target/
dbt/logs/
dbt/.user.yml
# dbt drops an anonymous-usage id next to whatever --profiles-dir it is given.
dbt/ci-profile/.user.yml
# profiles.yml is never committed — it holds credentials. Developers keep theirs
# in ~/.dbt/profiles.yml (see dbt/profiles.yml.example). The CREDENTIAL-FREE
# mock profile used by CI and run_tests.sh is the one exception and IS committed,
# at dbt/ci-profile/profiles.yml — see the header of that file.
dbt/profiles.yml

# dbt_packages are restored by `dbt deps` — no need to commit vendored copies
dbt/dbt_packages/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Terraform ─────────────────────────────────────────────────────────────────
# Provider binaries — restored by `terraform init`. Pattern is deliberately
# path-agnostic: the original `terraform/.terraform/` matched only the root
# module, so a second root module (terraform/github/) would have committed a
# 24MB provider binary.
**/.terraform/

# .terraform.lock.hcl is intentionally committed — it pins provider versions
# for reproducible runs across machines and CI.

# Local override files — never commit these
*.tfvars
*.tfvars.json
terraform.tfstate
terraform.tfstate.backup
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
.venv-airflow/
airflow/home/
venv/
*.egg-info/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Local pipeline runner ─────────────────────────────────────────────────────
# DuckDB database file — regenerated by local_runner.py
*.duckdb
# Raw API data — fetched on demand
local/data/
# dbt artifacts — restored by dbt deps / dbt run
local/dbt_packages/
local/target/
local/logs/

# ── Secrets / credentials ─────────────────────────────────────────────────────
*.pem
*.key
*.p8
.env
.env.*
local/.user.yml

# Terraform state can contain resource metadata and tokens. Path-agnostic so
# every root module is covered.
**/*.tfstate
**/*.tfstate.backup
tfplan
