# ── dbt ───────────────────────────────────────────────────────────────────────
dbt/target/
dbt/logs/
dbt/.user.yml
# profiles.yml is never committed — it holds credentials. CI workflows write an
# ephemeral placeholder profile at runtime; developers keep theirs in
# ~/.dbt/profiles.yml (see dbt/profiles.yml.example).
dbt/profiles.yml

# dbt_packages are restored by `dbt deps` — no need to commit vendored copies
dbt/dbt_packages/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Terraform ─────────────────────────────────────────────────────────────────
# Provider binaries — restored by `terraform init`
terraform/.terraform/

# .terraform.lock.hcl is intentionally committed — it pins provider versions
# for reproducible runs across machines and CI.

# Local override files — never commit these
*.tfvars
*.tfvars.json
terraform.tfstate
terraform.tfstate.backup
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Local pipeline runner ─────────────────────────────────────────────────────
# DuckDB database file — regenerated by local_runner.py
*.duckdb
# Raw API data — fetched on demand
local/data/
# dbt artifacts — restored by dbt deps / dbt run
local/dbt_packages/
local/target/
local/logs/

# ── Secrets / credentials ─────────────────────────────────────────────────────
*.pem
*.key
*.p8
.env
.env.*
local/.user.yml
