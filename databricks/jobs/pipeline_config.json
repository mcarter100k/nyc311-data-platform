{
  "_comment": [
    "Databricks job specs (Jobs API 2.1) for the deferred cloud deployment — see ADR 008.",
    "Orchestration is owned by the Airflow DAG (ADR 005): it does ALL scheduling and",
    "sequencing via DatabricksRunNowOperator against three single-task jobs. These are",
    "those three job definitions. Deliberately absent: any 'schedule' block (a second",
    "scheduler here would race Airflow's 06:00 UTC cron) and any 'depends_on' chain",
    "(sequencing lives in the DAG, in exactly one place).",
    "Deploy each with 'databricks jobs create', then record the returned job IDs in the",
    "Airflow Variables DATABRICKS_INGEST_JOB_ID / _BRONZE_JOB_ID / _SILVER_JOB_ID."
  ],
  "shared_cluster_spec": {
    "spark_version": "14.3.x-scala2.12",
    "node_type_id": "Standard_DS3_v2",
    "num_workers": 2,
    "spark_conf": {
      "spark.databricks.delta.preview.enabled": "true"
    }
  },
  "jobs": [
    {
      "name": "nyc311-ingest-raw",
      "max_concurrent_runs": 1,
      "tasks": [
        {
          "task_key": "ingest_raw",
          "new_cluster": "-> shared_cluster_spec",
          "notebook_task": {
            "notebook_path": "/Repos/nyc311-data-platform/databricks/notebooks/01_ingest_raw",
            "base_parameters": {
              "run_date": "{{run_date}}",
              "force_reload": "false"
            }
          }
        }
      ]
    },
    {
      "name": "nyc311-bronze",
      "max_concurrent_runs": 1,
      "tasks": [
        {
          "task_key": "bronze",
          "new_cluster": "-> shared_cluster_spec",
          "notebook_task": {
            "notebook_path": "/Repos/nyc311-data-platform/databricks/notebooks/02_bronze"
          }
        }
      ]
    },
    {
      "name": "nyc311-silver",
      "max_concurrent_runs": 1,
      "tasks": [
        {
          "task_key": "silver",
          "new_cluster": "-> shared_cluster_spec",
          "notebook_task": {
            "notebook_path": "/Repos/nyc311-data-platform/databricks/notebooks/03_silver"
          }
        }
      ]
    }
  ]
}
